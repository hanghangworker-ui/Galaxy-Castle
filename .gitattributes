# Normalize line endings in the repository so Windows, macOS and Linux clones
# stay consistent; Git checks files out with the native endings of the platform.
* text=auto eol=lf

# Windows launchers and scripts must keep CRLF so cmd.exe parses them correctly.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.psm1 text eol=crlf

# Binary files: never apply line-ending conversion or text diffing.
*.exe binary
*.dll binary
*.pck binary
*.001 binary
*.002 binary
*.003 binary
*.004 binary
*.005 binary
*.006 binary
*.007 binary
*.008 binary
*.009 binary
*.010 binary
*.011 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.wav binary
*.ogg binary
*.mp3 binary
*.zip binary
*.7z binary

# Keep the generated game build out of GitHub's language statistics.
data/** linguist-detectable=false
*.exe linguist-detectable=false
